# Fill these values locally or in the hosting dashboard. Never commit credentials.
PUBLIC_BASE_URL=https://YOUR-ACTUAL-FEEDBACK-HOST
GITHUB_OWNER=DVBeckwitt
GITHUB_REPO=Videre
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_FILE=/path/outside/repository/github-app.pem
FEEDBACK_DB=./data/feedback.sqlite
HOST=127.0.0.1
PORT=8787
# Generic server.mjs only: exact immediate proxy addresses whose header you control.
# For local.mjs, use its generated configuration and PROXY_MODE instead.
TRUSTED_PROXY_ADDRESSES=
TRUSTED_PROXY_HEADER=x-real-ip
