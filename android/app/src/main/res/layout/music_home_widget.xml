<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/music_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/music_widget_item"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/music_widget_open"
            android:focusable="true"
            android:gravity="center_vertical"
            android:importantForAccessibility="yes"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/music_widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/music_widget_name"
                android:textColor="#F8F3FF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/music_widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/music_widget_open"
                android:textColor="#E3D4F0"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/music_widget_save"
            style="@style/MusicWidgetControl"
            android:contentDescription="@string/music_widget_save"
            android:src="@drawable/music_widget_save"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/music_widget_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/music_widget_idle"
            android:textColor="#E3D4F0"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/music_widget_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/music_widget_previous"
                style="@style/MusicWidgetControl"
                android:contentDescription="@string/music_widget_previous"
                android:src="@drawable/music_widget_previous" />

            <ImageButton
                android:id="@+id/music_widget_toggle"
                style="@style/MusicWidgetControl"
                android:background="@drawable/music_widget_toggle_background"
                android:contentDescription="@string/music_widget_play"
                android:src="@drawable/music_widget_play"
                android:tint="#23182E" />

            <ImageButton
                android:id="@+id/music_widget_next"
                style="@style/MusicWidgetControl"
                android:contentDescription="@string/music_widget_next"
                android:src="@drawable/music_widget_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
