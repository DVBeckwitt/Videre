    <exclude domain="root" path="app_webview/" />
    <exclude domain="sharedpref" path="videre_gateway_sessions.xml" />
    <exclude domain="sharedpref" path="videre_nerdvpn_access.xml" />
    <exclude domain="sharedpref" path="videre_local_music.xml" />
    <exclude domain="file" path="community-music-covers-v1/" />
</full-backup-content>
