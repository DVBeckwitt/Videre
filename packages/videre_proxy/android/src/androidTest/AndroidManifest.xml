<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:usesCleartextTraffic="true" android:networkSecurityConfig="@xml/fixture_network_security">
        <provider
            android:name="com.github.dvbeckwitt.videre.proxy.RenditionFixtureDocumentsProvider"
            android:authorities="${applicationId}.saved-downloads"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
